#!/data/data/com.termux/files/usr/bin/bash

# FONT_DIR="$HOME/.font"
FONT_DIR="$HOME/storage/shared/Fonts"
TERMUX_DIR="$HOME/.termux"
TARGET="$TERMUX_DIR/font.ttf"
CURRENT_FILE="$TERMUX_DIR/current-font"

# Cek folder font
if [[ ! -d "$FONT_DIR" ]]; then
    echo "Error: folder font tidak ditemukan:"
    echo "  $FONT_DIR"
    exit 1
fi

# Ambil semua font
mapfile -t fonts < <(
    find "$FONT_DIR" -maxdepth 1 -type f \
        \( -iname "*.ttf" -o -iname "*.otf" \) \
        | sort
)

if (( ${#fonts[@]} == 0 )); then
    echo "Tidak ada font di:"
    echo "  $FONT_DIR"
    exit 1
fi

mkdir -p "$TERMUX_DIR"

# Font terakhir
current=""
if [[ -f "$CURRENT_FILE" ]]; then
    current=$(<"$CURRENT_FILE")
fi

echo
echo "  Termux Font Selector"
echo "  ────────────────────"
echo

# Buat nama pilihan
options=()

for font in "${fonts[@]}"; do
    name=$(basename "$font")
    name="${name%.*}"

    options+=("$name")
done

# Tampilkan menu
for i in "${!options[@]}"; do
    marker=""

    if [[ "${options[$i]}" == "$current" ]]; then
        marker="  ← current"
    fi

    printf "  %d) %s%s\n" "$((i + 1))" "${options[$i]}" "$marker"
done

echo
read -rp "  Pilih font [1-${#options[@]}]: " choice

# Validasi input
if ! [[ "$choice" =~ ^[0-9]+$ ]] ||
   (( choice < 1 || choice > ${#fonts[@]} )); then
    echo
    echo "  Pilihan tidak valid."
    exit 1
fi

index=$((choice - 1))
selected="${fonts[$index]}"
selected_name="${options[$index]}"

# Backup font lama
if [[ -f "$TARGET" ]]; then
    cp "$TARGET" "$TARGET.bak"
fi

# Pasang font
cp "$selected" "$TARGET"

# Simpan nama font terakhir
printf '%s\n' "$selected_name" > "$CURRENT_FILE"

echo
echo "  ✓ Font changed to: $selected_name"
echo
echo "  Restart/reload Termux untuk melihat perubahan."
echo
